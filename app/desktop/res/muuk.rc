// Muuk's Windows resources: the app icon (GLFW_ICON is also the window's
// title-bar icon -- GLFW picks it by that name) and the version info that
// Explorer and Task Manager show ("Muuk Upgrade" instead of muuk-upgrade-desktop.exe).
#include <winver.h>

GLFW_ICON ICON "muuk.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,2,1,0
 PRODUCTVERSION 0,2,1,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Muuk"
            VALUE "FileDescription", "Muuk Upgrade"
            VALUE "FileVersion", "0.2.1"
            VALUE "InternalName", "muuk-upgrade-desktop"
            VALUE "OriginalFilename", "muuk-upgrade-desktop.exe"
            VALUE "ProductName", "Muuk Upgrade"
            VALUE "ProductVersion", "0.2.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
